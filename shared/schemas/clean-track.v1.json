{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racketcoach.app/schemas/clean-track.v1.json",
  "title": "clean-track.v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "clean-track.v1"
    },
    "analysisId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "algoVersion": {
      "type": "string"
    },
    "analysisHz": {
      "anyOf": [
        {
          "type": "number",
          "const": 30
        },
        {
          "type": "number",
          "const": 60
        }
      ]
    },
    "display": {
      "type": "object",
      "properties": {
        "w": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "h": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["w", "h"],
      "additionalProperties": false
    },
    "mirrored": {
      "type": "boolean"
    },
    "torsoT": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "jointOrder": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "t0Us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tUs": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "kp": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "interp": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 524287
      }
    },
    "strokes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CleanStroke"
      }
    }
  },
  "required": ["schema", "analysisId", "algoVersion", "analysisHz", "display", "mirrored", "torsoT", "jointOrder", "t0Us", "tUs", "kp", "interp", "strokes"],
  "additionalProperties": false,
  "$defs": {
    "CleanStroke": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "tStartUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tContactUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contactIsEstimate": {
          "type": "boolean"
        },
        "tEndUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "phases": {
          "type": "object",
          "properties": {
            "swingStart": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "ready": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bsEnd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "contact": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ftStop": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "recovery": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["swingStart", "ready", "bsEnd", "contact", "ftStop", "recovery"],
          "additionalProperties": false
        },
        "role": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["best", "worst"]
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded": {
          "type": "boolean"
        }
      },
      "required": ["id", "tStartUs", "tContactUs", "contactIsEstimate", "tEndUs", "phases", "role", "excluded"],
      "additionalProperties": false
    }
  }
}
