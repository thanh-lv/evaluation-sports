{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racketcoach.app/schemas/reprepare.v1.json",
  "title": "reprepare.v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "reprepare.v1"
    },
    "analysisId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "cameraView": {
      "type": "string",
      "enum": ["side", "behind", "front", "diagonal"]
    },
    "excludedStrokeIds": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "handedness": {
      "type": "string",
      "enum": ["right", "left"]
    }
  },
  "required": ["schema", "analysisId", "cameraView", "excludedStrokeIds", "handedness"]
}
