{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "input_check", "visual_checkpoints", "summary", "strengths", "weaknesses", "improvements", "safety_notes", "not_assessable", "recording_tips"],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "input_check": {
      "$ref": "#/$defs/InputCheck"
    },
    "visual_checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VisualJudgment"
      }
    },
    "summary": {
      "type": "string",
      "description": "two or three encouraging sentences"
    },
    "strengths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Strength"
      },
      "description": "one to three"
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Weakness"
      },
      "description": "one to three, most impactful first"
    },
    "improvements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Improvement"
      },
      "description": "one per weakness"
    },
    "safety_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SafetyNote"
      }
    },
    "not_assessable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NotAssessable"
      }
    },
    "recording_tips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "enum": ["coach.v1"]
    },
    "Language": {
      "type": "string",
      "enum": ["vi", "en"]
    },
    "CheckpointId": {
      "type": "string",
      "enum": ["pb.ready.PR1", "pb.ready.PR2", "pb.ready.PR3", "pb.ready.PR4", "pb.ready.PR5", "pb.ready.PR6", "pb.ready.PR7", "pb.split.S1", "pb.serve.SV1", "pb.serve.SV2", "pb.serve.SV3", "pb.serve.SV4", "pb.serve.SV5", "pb.serve.SV6", "pb.serve.SV7", "pb.serve.SV8", "pb.serve.SV9", "pb.serve.SV10", "pb.serve.SV11", "pb.dink.DK1", "pb.dink.DK2", "pb.dink.DK3", "pb.dink.DK4", "pb.dink.DK5", "pb.dink.DK6", "pb.dink.DK7", "pb.dink.DK8", "pb.dink.DK9", "pb.dink.DK10", "pb.dink.DK11", "pb.drop3.TD1", "pb.drop3.TD2", "pb.drop3.TD3", "pb.drop3.TD4", "pb.drop3.TD5", "pb.drop3.TD6", "pb.drop3.TD7", "pb.drop3.TD8", "pb.return.RT2", "pb.return.RT3", "pb.return.RT4", "pb.return.RT5", "pb.return.RT6", "pb.return.RT7", "pb.return.RT8", "pb.drive.DV1", "pb.drive.DV2", "pb.drive.DV3", "pb.drive.DV4", "pb.drive.DV5", "pb.drive.DV6", "pb.drive.DV7", "pb.drive.DV8", "pb.volley.VO1", "pb.volley.VO2", "pb.volley.VO3", "pb.volley.VO4", "pb.volley.VO5", "pb.volley.VO6", "pb.volley.VO7", "pb.volley.VO8", "pb.volley.VO9"]
    },
    "VisualCheckpointId": {
      "type": "string",
      "enum": ["pb.ready.PR6", "pb.serve.SV11", "pb.dink.DK4", "pb.drop3.TD6", "pb.return.RT2", "pb.volley.VO8"]
    },
    "FaultId": {
      "type": "string",
      "enum": ["pb.ready.narrow_feet", "pb.ready.straight_legs", "pb.ready.weight_back", "pb.ready.paddle_down", "pb.ready.paddle_close", "pb.ready.tip_down", "pb.ready.turned", "pb.split.no_split", "pb.serve.square_stance", "pb.serve.stiff_legs", "pb.serve.early_weight", "pb.serve.bent_elbow", "pb.serve.late_contact", "pb.serve.high_contact", "pb.serve.flat_swing", "pb.serve.no_transfer", "pb.serve.short_finish", "pb.serve.runs_in", "pb.serve.wrist_flick", "pb.dink.standing_tall", "pb.dink.waist_bend", "pb.dink.big_backswing", "pb.dink.wristy", "pb.dink.late_contact", "pb.dink.no_lift", "pb.dink.long_follow", "pb.dink.head_moves", "pb.dink.moving_at_contact", "pb.dink.reaching_fh", "pb.dink.reaching_bh", "pb.dink.paddle_drops", "pb.drop3.on_the_run", "pb.drop3.standing_tall", "pb.drop3.late_contact", "pb.drop3.low_finish", "pb.drop3.high_finish", "pb.drop3.big_backswing", "pb.drop3.wristy", "pb.drop3.stays_back", "pb.drop3.flat_swing", "pb.return.not_set", "pb.return.no_turn", "pb.return.big_backswing", "pb.return.late_contact", "pb.return.stays_back", "pb.return.flat_swing", "pb.return.low_finish", "pb.drive.arm_only", "pb.drive.short_backswing", "pb.drive.big_backswing", "pb.drive.late_contact", "pb.drive.weight_back", "pb.drive.hits_down", "pb.drive.short_finish", "pb.drive.low_finish", "pb.drive.slow_reset", "pb.volley.paddle_down", "pb.volley.big_swing", "pb.volley.late_contact", "pb.volley.long_follow", "pb.volley.standing_tall", "pb.volley.moving", "pb.volley.leaning_back", "pb.volley.chicken_wing", "pb.volley.paddle_drops", "none"]
    },
    "Severity": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "Confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "Visibility": {
      "type": "string",
      "enum": ["good", "partial", "poor"]
    },
    "InputIssue": {
      "type": "string",
      "enum": ["no_person", "wrong_person", "subject_cut_off", "too_dark", "motion_blur", "too_far", "occlusion", "wrong_sport", "wrong_skill", "camera_angle_limits", "other"]
    },
    "SafetyKind": {
      "type": "string",
      "enum": ["warmup", "load", "technique_risk", "see_professional"]
    },
    "FrameId": {
      "type": "string",
      "enum": ["F1", "F2", "F3", "F4", "F5"]
    },
    "EmptyString": {
      "type": "string",
      "enum": [""],
      "description": "empty: no value"
    },
    "InputCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_assessable", "sport_matches", "skill_matches", "subject_visibility", "issues", "note"],
      "properties": {
        "is_assessable": {
          "type": "boolean"
        },
        "sport_matches": {
          "type": "boolean"
        },
        "skill_matches": {
          "type": "boolean"
        },
        "subject_visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputIssue"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "VisualJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "level", "confidence", "frame_ids", "note"],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/VisualCheckpointId"
        },
        "level": {
          "type": "integer",
          "description": "0-4 per the anchors; -1 = not assessable"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "frame_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameId"
          },
          "description": "frames that show it"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stroke_id", "frame_id", "metric_key", "observation"],
      "properties": {
        "stroke_id": {
          "type": "integer",
          "description": "stroke id from <strokes>; -1 = whole clip"
        },
        "frame_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameId"
            },
            {
              "$ref": "#/$defs/EmptyString"
            }
          ],
          "description": "frame that shows it, or \"\" if none"
        },
        "metric_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckpointId"
            },
            {
              "$ref": "#/$defs/EmptyString"
            }
          ],
          "description": "checkpoint id from <checkpoints>, or \"\" for a visual-only observation"
        },
        "observation": {
          "type": "string",
          "description": "plain language, no digits or units"
        }
      }
    },
    "Strength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "title", "detail", "evidence"],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/CheckpointId"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      }
    },
    "Weakness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "fault_id", "severity", "title", "detail", "why_it_matters", "evidence"],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/CheckpointId"
        },
        "fault_id": {
          "$ref": "#/$defs/FaultId"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      }
    },
    "Improvement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "fault_id", "title", "how_to_fix", "cues", "drill_ids", "goal"],
      "properties": {
        "priority": {
          "type": "integer",
          "description": "1 = most important"
        },
        "fault_id": {
          "$ref": "#/$defs/FaultId"
        },
        "title": {
          "type": "string"
        },
        "how_to_fix": {
          "type": "string"
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "each at most eight words"
        },
        "drill_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "one or two ids from the fault allowed drills"
        },
        "goal": {
          "type": "string"
        }
      }
    },
    "SafetyNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/SafetyKind"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "NotAssessable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "how_to_capture"],
      "properties": {
        "aspect": {
          "type": "string"
        },
        "how_to_capture": {
          "type": "string"
        }
      }
    }
  }
}
