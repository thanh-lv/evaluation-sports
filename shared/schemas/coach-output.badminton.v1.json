{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "input_check", "visual_checkpoints", "summary", "strengths", "weaknesses", "improvements", "safety_notes", "not_assessable", "recording_tips"],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "input_check": {
      "$ref": "#/$defs/InputCheck"
    },
    "visual_checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VisualJudgment"
      }
    },
    "summary": {
      "type": "string",
      "description": "two or three encouraging sentences"
    },
    "strengths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Strength"
      },
      "description": "one to three"
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Weakness"
      },
      "description": "one to three, most impactful first"
    },
    "improvements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Improvement"
      },
      "description": "one per weakness"
    },
    "safety_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SafetyNote"
      }
    },
    "not_assessable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NotAssessable"
      }
    },
    "recording_tips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "enum": ["coach.v1"]
    },
    "Language": {
      "type": "string",
      "enum": ["vi", "en"]
    },
    "CheckpointId": {
      "type": "string",
      "enum": ["bd.ready.R1", "bd.ready.R2", "bd.ready.R3", "bd.ready.R4", "bd.ready.R7", "bd.split.S1", "bd.clear_fh.C1", "bd.clear_fh.C2", "bd.clear_fh.C3", "bd.clear_fh.C4", "bd.clear_fh.C5", "bd.clear_fh.C6", "bd.clear_fh.C7", "bd.clear_fh.C8", "bd.clear_fh.C9", "bd.clear_fh.C10", "bd.clear_fh.C11", "bd.clear_fh.C12", "bd.clear_fh.C13", "bd.smash.SM2", "bd.smash.SM3", "bd.smash.SM4", "bd.smash.SM5", "bd.smash.SM6", "bd.smash.SM7", "bd.smash.SM8", "bd.smash.SM9", "bd.smash.SM10", "bd.serve_low.LS1", "bd.serve_low.LS2", "bd.serve_low.LS3", "bd.serve_low.LS4", "bd.serve_low.LS5", "bd.serve_low.LS6", "bd.serve_low.LS7", "bd.serve_low.LS8", "bd.serve_low.LS9", "bd.serve_low.LS10", "bd.net_shot.NS1", "bd.net_shot.NS2", "bd.net_shot.NS3", "bd.net_shot.NS4", "bd.net_shot.NS5", "bd.net_shot.NS6", "bd.net_shot.NS7", "bd.net_shot.NS8", "bd.net_shot.NS9", "bd.net_shot.NS10", "bd.net_shot.NS11", "bd.net_shot.NS12", "bd.lift.NL1", "bd.lift.NL2", "bd.lift.NL3", "bd.serve_high.HS1", "bd.serve_high.HS2", "bd.serve_high.HS3", "bd.serve_high.HS4", "bd.serve_high.HS5", "bd.serve_high.HS6", "bd.serve_high.HS7", "bd.serve_high.HS8", "bd.serve_high.HS9"]
    },
    "VisualCheckpointId": {
      "type": "string",
      "enum": ["bd.ready.R7", "bd.clear_fh.C13", "bd.smash.SM10", "bd.serve_low.LS10", "bd.net_shot.NS2"]
    },
    "FaultId": {
      "type": "string",
      "enum": ["bd.ready.narrow_feet", "bd.ready.straight_legs", "bd.ready.weight_back", "bd.ready.racket_down", "bd.ready.head_down", "bd.split.no_split", "bd.clear_fh.no_turn", "bd.clear_fh.limp_arm", "bd.clear_fh.low_elbow", "bd.clear_fh.no_weight_transfer", "bd.clear_fh.low_contact", "bd.clear_fh.late_contact", "bd.clear_fh.bent_arm", "bd.clear_fh.short_finish", "bd.clear_fh.no_rotation", "bd.clear_fh.high_finish", "bd.clear_fh.no_recovery", "bd.clear_fh.racket_stays_down", "bd.clear_fh.late_footwork", "bd.smash.low_contact", "bd.smash.behind_head", "bd.smash.bent_arm", "bd.smash.arm_only", "bd.smash.short_finish", "bd.smash.stiff_landing", "bd.smash.high_finish", "bd.smash.slow_recovery", "bd.smash.open_face", "bd.serve_low.feet_move", "bd.serve_low.square_stance", "bd.serve_low.stiff_legs", "bd.serve_low.leaning_back", "bd.serve_low.cramped", "bd.serve_low.high_contact", "bd.serve_low.big_backswing", "bd.serve_low.long_push", "bd.serve_low.racket_down", "bd.serve_low.wrist_flick", "bd.net_shot.racket_low", "bd.net_shot.wrong_leg", "bd.net_shot.short_lunge", "bd.net_shot.shallow_lunge", "bd.net_shot.waist_bend", "bd.net_shot.knee_past_toes", "bd.net_shot.late_contact", "bd.net_shot.bent_arm", "bd.net_shot.low_contact", "bd.net_shot.big_swing", "bd.net_shot.long_follow", "bd.net_shot.stays_at_net", "bd.lift.big_backswing", "bd.lift.flat_lift", "bd.lift.low_finish", "bd.serve_high.square_stance", "bd.serve_high.early_weight", "bd.serve_high.arm_only", "bd.serve_high.short_swing", "bd.serve_high.flat_contact", "bd.serve_high.high_contact", "bd.serve_high.low_finish", "bd.serve_high.short_finish", "bd.serve_high.racket_down", "none"]
    },
    "Severity": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "Confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "Visibility": {
      "type": "string",
      "enum": ["good", "partial", "poor"]
    },
    "InputIssue": {
      "type": "string",
      "enum": ["no_person", "wrong_person", "subject_cut_off", "too_dark", "motion_blur", "too_far", "occlusion", "wrong_sport", "wrong_skill", "camera_angle_limits", "other"]
    },
    "SafetyKind": {
      "type": "string",
      "enum": ["warmup", "load", "technique_risk", "see_professional"]
    },
    "FrameId": {
      "type": "string",
      "enum": ["F1", "F2", "F3", "F4", "F5"]
    },
    "EmptyString": {
      "type": "string",
      "enum": [""],
      "description": "empty: no value"
    },
    "InputCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_assessable", "sport_matches", "skill_matches", "subject_visibility", "issues", "note"],
      "properties": {
        "is_assessable": {
          "type": "boolean"
        },
        "sport_matches": {
          "type": "boolean"
        },
        "skill_matches": {
          "type": "boolean"
        },
        "subject_visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputIssue"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "VisualJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "level", "confidence", "frame_ids", "note"],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/VisualCheckpointId"
        },
        "level": {
          "type": "integer",
          "description": "0-4 per the anchors; -1 = not assessable"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "frame_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameId"
          },
          "description": "frames that show it"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stroke_id", "frame_id", "metric_key", "observation"],
      "properties": {
        "stroke_id": {
          "type": "integer",
          "description": "stroke id from <strokes>; -1 = whole clip"
        },
        "frame_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameId"
            },
            {
              "$ref": "#/$defs/EmptyString"
            }
          ],
          "description": "frame that shows it, or \"\" if none"
        },
        "metric_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckpointId"
            },
            {
              "$ref": "#/$defs/EmptyString"
            }
          ],
          "description": "checkpoint id from <checkpoints>, or \"\" for a visual-only observation"
        },
        "observation": {
          "type": "string",
          "description": "plain language, no digits or units"
        }
      }
    },
    "Strength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "title", "detail", "evidence"],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/CheckpointId"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      }
    },
    "Weakness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "fault_id", "severity", "title", "detail", "why_it_matters", "evidence"],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/CheckpointId"
        },
        "fault_id": {
          "$ref": "#/$defs/FaultId"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      }
    },
    "Improvement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "fault_id", "title", "how_to_fix", "cues", "drill_ids", "goal"],
      "properties": {
        "priority": {
          "type": "integer",
          "description": "1 = most important"
        },
        "fault_id": {
          "$ref": "#/$defs/FaultId"
        },
        "title": {
          "type": "string"
        },
        "how_to_fix": {
          "type": "string"
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "each at most eight words"
        },
        "drill_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "one or two ids from the fault allowed drills"
        },
        "goal": {
          "type": "string"
        }
      }
    },
    "SafetyNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/SafetyKind"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "NotAssessable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "how_to_capture"],
      "properties": {
        "aspect": {
          "type": "string"
        },
        "how_to_capture": {
          "type": "string"
        }
      }
    }
  }
}
