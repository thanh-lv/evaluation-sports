{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "input_check", "visual_checkpoints", "summary", "strengths", "weaknesses", "improvements", "safety_notes", "not_assessable", "recording_tips"],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "input_check": {
      "$ref": "#/$defs/InputCheck"
    },
    "visual_checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VisualJudgment"
      }
    },
    "summary": {
      "type": "string",
      "description": "two or three encouraging sentences"
    },
    "strengths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Strength"
      },
      "description": "one to three"
    },
    "weaknesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Weakness"
      },
      "description": "one to three, most impactful first"
    },
    "improvements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Improvement"
      },
      "description": "one per weakness"
    },
    "safety_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SafetyNote"
      }
    },
    "not_assessable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NotAssessable"
      }
    },
    "recording_tips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "enum": ["coach.v1"]
    },
    "Language": {
      "type": "string",
      "enum": ["vi", "en"]
    },
    "CheckpointId": {
      "type": "string",
      "enum": ["bd.clear_fh.C3", "bd.ready.R7"]
    },
    "VisualCheckpointId": {
      "type": "string",
      "enum": ["bd.ready.R7"]
    },
    "FaultId": {
      "type": "string",
      "enum": ["bd.clear_fh.low_elbow", "none"]
    },
    "Severity": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "Confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "Visibility": {
      "type": "string",
      "enum": ["good", "partial", "poor"]
    },
    "InputIssue": {
      "type": "string",
      "enum": ["no_person", "wrong_person", "subject_cut_off", "too_dark", "motion_blur", "too_far", "occlusion", "wrong_sport", "wrong_skill", "camera_angle_limits", "other"]
    },
    "SafetyKind": {
      "type": "string",
      "enum": ["warmup", "load", "technique_risk", "see_professional"]
    },
    "FrameId": {
      "type": "string",
      "enum": ["F1", "F2", "F3", "F4", "F5"]
    },
    "EmptyString": {
      "type": "string",
      "enum": [""],
      "description": "empty: no value"
    },
    "InputCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_assessable", "sport_matches", "skill_matches", "subject_visibility", "issues", "note"],
      "properties": {
        "is_assessable": {
          "type": "boolean"
        },
        "sport_matches": {
          "type": "boolean"
        },
        "skill_matches": {
          "type": "boolean"
        },
        "subject_visibility": {
          "$ref": "#/$defs/Visibility"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputIssue"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "VisualJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "level", "confidence", "frame_ids", "note"],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/VisualCheckpointId"
        },
        "level": {
          "type": "integer",
          "description": "0-4 per the anchors; -1 = not assessable"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "frame_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameId"
          },
          "description": "frames that show it"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stroke_id", "frame_id", "metric_key", "observation"],
      "properties": {
        "stroke_id": {
          "type": "integer",
          "description": "stroke id from <strokes>; -1 = whole clip"
        },
        "frame_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameId"
            },
            {
              "$ref": "#/$defs/EmptyString"
            }
          ],
          "description": "frame that shows it, or \"\" if none"
        },
        "metric_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/CheckpointId"
            },
            {
              "$ref": "#/$defs/EmptyString"
            }
          ],
          "description": "checkpoint id from <checkpoints>, or \"\" for a visual-only observation"
        },
        "observation": {
          "type": "string",
          "description": "plain language, no digits or units"
        }
      }
    },
    "Strength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "title", "detail", "evidence"],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/CheckpointId"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      }
    },
    "Weakness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "fault_id", "severity", "title", "detail", "why_it_matters", "evidence"],
      "properties": {
        "checkpoint_id": {
          "$ref": "#/$defs/CheckpointId"
        },
        "fault_id": {
          "$ref": "#/$defs/FaultId"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          }
        }
      }
    },
    "Improvement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "fault_id", "title", "how_to_fix", "cues", "drill_ids", "goal"],
      "properties": {
        "priority": {
          "type": "integer",
          "description": "1 = most important"
        },
        "fault_id": {
          "$ref": "#/$defs/FaultId"
        },
        "title": {
          "type": "string"
        },
        "how_to_fix": {
          "type": "string"
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "each at most eight words"
        },
        "drill_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "one or two ids from the fault allowed drills"
        },
        "goal": {
          "type": "string"
        }
      }
    },
    "SafetyNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/SafetyKind"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "NotAssessable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect", "how_to_capture"],
      "properties": {
        "aspect": {
          "type": "string"
        },
        "how_to_capture": {
          "type": "string"
        }
      }
    }
  }
}
