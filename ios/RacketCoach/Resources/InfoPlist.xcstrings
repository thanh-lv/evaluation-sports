    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt. Verbatim from DESIGN.md §10.1; do not change without updating the design and docs/legal/consent-texts.*.md §4.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RacketCoach uses the camera to record your strokes. The video is analyzed on your iPhone and never uploaded. Only pose data and up to 5 still images (faces automatically blurred) are sent for AI analysis, after you agree."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng dùng camera để quay cú đánh của bạn. Video được phân tích trên máy và không bị tải lên. Chỉ dữ liệu tư thế và tối đa 5 ảnh tĩnh (đã tự động làm mờ khuôn mặt) được gửi đi để AI phân tích, sau khi bạn đồng ý."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
