    "consent.link.privacy" : {
      "comment" : "Link to the privacy policy web page.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Policy"
          }
        },
        "vi" : {
