          }
        }
      }
    },
    "consent.intro" : {
      "comment" : "Intro of the consent sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For the AI to review your strokes, we need your consent. The first two items are required; the last two are up to you."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để AI nhận xét cú đánh của bạn, chúng tôi cần sự đồng ý của bạn. Hai mục đầu là bắt buộc; hai mục sau tuỳ bạn chọn."
          }
        }
      }
    },
    "consent.link.ai" : {
      "comment" : "Link to the AI disclosure web page.",
