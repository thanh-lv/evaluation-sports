    "consent.ai.body" : {
      "comment" : "(b) Full text with line breaks and bullets. Exact legal wording; must keep the best-effort blur wording and Anthropic's retention period.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your feedback is written by Claude, an AI model made by Anthropic PBC in the USA. For each analysis we send Anthropic:\n• the pose coordinates of your strokes;\n• up to 5 still images, with faces automatically blurred (best effort, which cannot be guaranteed in every case) and other people masked;\n• sport, skill, camera view, handedness and level.\nYour video is never uploaded. We delete the still images as soon as the analysis finishes, at the latest after 72 hours. Under Anthropic's current policy, data sent through its API is deleted automatically within 30 days (longer if flagged for a usage-policy violation) and is not used to train AI models.\nYou can withdraw consent at any time in Settings › Privacy; you then won't be able to start new analyses."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận xét được viết bởi Claude, mô hình AI của Anthropic PBC tại Hoa Kỳ. Với mỗi phân tích, chúng tôi gửi cho Anthropic:\n• toạ độ tư thế của các cú đánh;\n• tối đa 5 ảnh tĩnh, trong đó khuôn mặt được tự động làm mờ (ở mức tốt nhất có thể, không đảm bảo trong mọi trường hợp) và những người khác bị che;\n• môn, kỹ thuật, góc quay, tay thuận và trình độ.\nVideo của bạn không bao giờ được tải lên. Chúng tôi xoá ảnh tĩnh ngay khi phân tích xong, chậm nhất sau 72 giờ. Theo chính sách hiện hành của Anthropic, dữ liệu gửi qua API được tự động xoá trong vòng 30 ngày (lâu hơn nếu bị gắn cờ vi phạm chính sách sử dụng) và không được dùng để huấn luyện AI.\nBạn có thể rút lại đồng ý bất cứ lúc nào trong Cài đặt › Quyền riêng tư; khi đó bạn sẽ không tạo được phân tích mới."
          }
        }
      }
    },
    "consent.ai.checkbox" : {
      "comment" : "(b) Checkbox label, unticked by default.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I agree to send the data above to Anthropic in the USA for AI analysis."
          }
