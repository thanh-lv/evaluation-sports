    "consent.calibration.body" : {
      "comment" : "(c) Explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turn this on, we may use your pose data and analysis results, with identifying information removed and without images, to calibrate the scoring and check quality. You can turn it off at any time in Settings › Privacy."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn bật, chúng tôi có thể dùng dữ liệu tư thế và kết quả phân tích của bạn, sau khi đã loại bỏ thông tin định danh và không kèm ảnh, để hiệu chỉnh thang chấm và kiểm tra chất lượng. Bạn có thể tắt bất cứ lúc nào trong Cài đặt › Quyền riêng tư."
          }
        }
      }
    },
    "consent.calibration.title" : {
      "comment" : "(c) Optional item title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improve accuracy (optional)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cải thiện độ chính xác (không bắt buộc)"
          }
        }
      }
    },
    "consent.calibration.toggle" : {
      "comment" : "(c) Toggle label, off by default (DESIGN.md §2.2 step 5c).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow anonymized data to be used to improve accuracy"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép dùng dữ liệu đã ẩn danh để cải thiện độ chính xác"
          }
        }
      }
    },
    "consent.consumption.body" : {
      "comment" : "(d) Explanation of consumption information sent to Apple on refund requests.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you ask Apple for a refund of Premium, Apple may ask us how you used the service. If you turn this on, we send Apple a summary such as how much of the service you used, how long you have used it and your in-app purchase history; we never send images, pose data or feedback content. If you leave it off, we send nothing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn yêu cầu Apple hoàn tiền gói Premium, Apple có thể hỏi chúng tôi về mức sử dụng của bạn. Nếu bạn bật, chúng tôi gửi cho Apple bản tóm tắt như mức độ bạn đã dùng dịch vụ, thời gian sử dụng và lịch sử mua trong ứng dụng; không gửi ảnh, dữ liệu tư thế hay nội dung nhận xét. Nếu bạn không bật, chúng tôi không gửi gì."
          }
        }
      }
    },
    "consent.consumption.title" : {
      "comment" : "(d) Optional item title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share with Apple on refund requests (optional)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ với Apple khi hoàn tiền (không bắt buộc)"
          }
        }
      }
    },
    "consent.consumption.toggle" : {
      "comment" : "(d) Toggle label, off by default.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow sending usage information to Apple when I request a refund"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép gửi thông tin sử dụng cho Apple khi tôi yêu cầu hoàn tiền"
          }
        }
      }
    },
    "consent.declined.message" : {
      "comment" : "Shown after 'Not now'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can still view the sample analysis. To analyze your own videos, agree to the two required items."
