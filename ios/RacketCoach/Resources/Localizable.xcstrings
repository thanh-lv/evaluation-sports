    },
    "consent.pdpl.body" : {
      "comment" : "(a) Full text. Exact legal wording from docs/legal/consent-texts.*.md; counsel review pending.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We process pose data (the positions of your body joints over time), up to 5 still images and the details you choose (sport, skill, camera view, handedness, level) to analyze your strokes and keep your history. The data is stored on Supabase servers in Singapore, which means it is transferred outside Vietnam. Still images are deleted as soon as the analysis finishes, at the latest after 72 hours. Pose data and results are kept until you delete the analysis or your account; pose data is deleted automatically after 24 months without using the app."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi xử lý dữ liệu tư thế (vị trí các khớp cơ thể theo thời gian), tối đa 5 ảnh tĩnh và thông tin bạn chọn (môn, kỹ thuật, góc quay, tay thuận, trình độ) để phân tích cú đánh và lưu lịch sử cho bạn. Dữ liệu được lưu trên máy chủ của Supabase tại Singapore, tức là được chuyển ra ngoài Việt Nam. Ảnh tĩnh bị xoá ngay khi phân tích xong, chậm nhất sau 72 giờ. Dữ liệu tư thế và kết quả được giữ đến khi bạn xoá phân tích hoặc tài khoản; dữ liệu tư thế tự xoá sau 24 tháng bạn không dùng ứng dụng."
          }
        }
      }
    },
    "consent.pdpl.checkbox" : {
      "comment" : "(a) Checkbox label, unticked by default.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I agree to the processing and the transfer to Singapore described above."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi đồng ý với việc xử lý dữ liệu và chuyển dữ liệu đến Singapore như trên."
          }
        }
      }
    },
    "consent.pdpl.title" : {
      "comment" : "(a) Required item title: processing and cross-border transfer (PDPL). Changing (a) requires bumping consent_versions.pdpl.",
