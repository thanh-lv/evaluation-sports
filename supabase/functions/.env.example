# Edge Function secrets. Copy to supabase/functions/.env for `supabase start` / `supabase functions serve`
# (the CLI loads that file automatically), and set the same names with `supabase secrets set` for a hosted project.
# Read by supabase/functions/_shared/env.ts (`loadEnv`).
#
# Do not put SUPABASE_* names here: the runtime injects SUPABASE_URL and the API keys
# (SUPABASE_SECRET_KEY(S) / SUPABASE_SERVICE_ROLE_KEY, SUPABASE_PUBLISHABLE_KEY(S) / SUPABASE_ANON_KEY) and drops
# user secrets with that prefix.
#
# Values below are local-only placeholders. Generate real ones with:
#   openssl rand -base64 32      (TOKEN_ENC_KEY: must decode to exactly 32 bytes)
#   openssl rand -hex 32         (INTERNAL_SECRET, CRON_SECRET, AUDIT_PEPPER, LOG_PEPPER)

# --- Claude -------------------------------------------------------------------------------------------------------
# CLAUDE_MODE defaults to live; mock (no network, canned coach.v1 output) must be set explicitly, as below for local
# dev. CLAUDE_MODE=live without a key is a startup error; with neither set, analysis jobs fail (never mock output).
ANTHROPIC_API_KEY=
CLAUDE_MODE=mock

# --- Shared secrets (also stored in Vault as internal_secret / cron_secret, see migrations/…0900_cron.sql) ----------
# /analyze/run checks the x-internal-secret header; /cron checks x-cron-secret.
INTERNAL_SECRET=local-internal-secret-change-me
CRON_SECRET=local-cron-secret-change-me

# --- Crypto -------------------------------------------------------------------------------------------------------
# AES-256-GCM key for private.apple_auth_tokens (base64 or base64url of 32 bytes). Rotating it makes stored tokens
# unreadable (users then get siwaManualRevoke).
TOKEN_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# sha256(uid + AUDIT_PEPPER) is the audit_log subject for deleted accounts.
AUDIT_PEPPER=local-audit-pepper
# Salt for user-id hashes in logs (optional; a fixed namespace is used when empty).
LOG_PEPPER=
# debug | info | warn | error (default info)
LOG_LEVEL=info

# --- Apple (all optional until M8–M9; a function that needs a missing value answers 500 and logs its name) ---------
APPLE_BUNDLE_ID=
APPLE_APP_APPLE_ID=
APPLE_TEAM_ID=
# App Store Server API (In-App Purchase key, .p8 contents; literal \n are turned into newlines)
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# Sign in with Apple (client secret for /auth/token and /auth/revoke). APPLE_SIWA_CLIENT_ID defaults to the bundle id.
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
APPLE_SIWA_CLIENT_ID=
# DeviceCheck (first-submit bonus bit)
APPLE_DEVICECHECK_KEY_ID=
APPLE_DEVICECHECK_PRIVATE_KEY=
# Host overrides (bare host or http(s) origin), e.g. a local mock server for tests.
APPLE_API_HOST_PROD=api.storekit.apple.com
APPLE_API_HOST_SANDBOX=api.storekit-sandbox.apple.com
APPLE_DEVICECHECK_HOST=api.devicecheck.apple.com
# Optional EXTRA trusted root PEM(s) for StoreKit / notification JWS chains. Apple Root CA G3 is embedded in
# _shared/apple/jws.ts; set this only if Apple adds a root (see docs/apple-setup.md). Literal \n become newlines.
APPLE_ROOT_CA_G3_PEM=
# Dev project only: accept StoreKit transactions from the Xcode environment without calling Apple (DESIGN §9.4).
ALLOW_XCODE_ENV=false
