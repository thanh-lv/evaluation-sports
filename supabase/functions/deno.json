{
  "imports": {
    "zod": "npm:zod@4.6.5",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@0.131.0",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.117.2",
    "jose": "npm:jose@6.2.12",
    "@peculiar/asn1-x509": "npm:@peculiar/asn1-x509@2.10.0",
    "@peculiar/x509": "npm:@peculiar/x509@2.1.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@shared/": "./_shared/"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "lock": false,
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "test": "deno test -A ../tests",
    "schemas": "deno run -A ../../scripts/gen-schemas.ts"
  }
}
